# คัดลอกไฟล์นี้เป็น .dev.vars (ห้าม commit) — ใช้ในเครื่องเท่านั้น
# production ให้ตั้งด้วย: npx wrangler secret put <NAME>
ADMIN_INITIAL_PASSWORD=change-me-at-least-10-chars
# Turnstile test secret (ผ่านทุกครั้ง) — production ใส่ secret จริงจากแดชบอร์ด
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
